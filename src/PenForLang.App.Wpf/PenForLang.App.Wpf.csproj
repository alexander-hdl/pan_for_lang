<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Своя точка входа: параметры командной строки (mouse, wpf-stylus и др.) нужны до создания Application. -->
    <StartupObject>PenForLang.App.Wpf.Program</StartupObject>
    <Description>Корень композиции и оболочка приложения (WPF). Per-Monitor V2 DPI задан в app.manifest.</Description>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\PenForLang.Core\PenForLang.Core.csproj" />
    <ProjectReference Include="..\PenForLang.Ink\PenForLang.Ink.csproj" />
    <ProjectReference Include="..\PenForLang.Glyphs\PenForLang.Glyphs.csproj" />
    <ProjectReference Include="..\PenForLang.Evaluation\PenForLang.Evaluation.csproj" />
    <ProjectReference Include="..\PenForLang.Platform.Windows\PenForLang.Platform.Windows.csproj" />
    <ProjectReference Include="..\PenForLang.Wpf.Controls\PenForLang.Wpf.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ADR-003 / ARCHITECTURE.md §7.1: отключаем WISP/стилус WPF, чтобы WM_POINTER пера доходили до хука окна, а не забирались
      RealTimeStylus (в этом случае окно получает контакт только мышиными сообщениями). Попадает в PenForLang.App.Wpf.runtimeconfig.json;
      флаг командной строки wpf-stylus переопределяет значение (см. Program.cs). Работает ли на целевом железе — [не проверено, V0.5/S1].
    -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI-тесты окна урока читают его внутренности (ViewModel, слои, кнопки). -->
    <InternalsVisibleTo Include="PenForLang.App.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Контент песочницы (V0.6): стиль-пакет zaner-bloser кладётся рядом с exe в content/styles/... при сборке и публикации. -->
    <None Include="..\..\content\styles\**\*" Link="content\styles\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Урок V0.8: числа оценщика и сценария (config) и строки RU/EN (locales) — тоже рядом с exe. -->
    <None Include="..\..\content\config\**\*" Link="content\config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\content\locales\**\*" Link="content\locales\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Запускатели протокола V0 (0-mouse.cmd ... 5-latency.cmd, режим песочницы sandbox) и плейтеста урока V0.8 (lesson-*.cmd) кладутся рядом с exe. -->
    <None Include="..\..\build\v0\*.cmd;..\..\build\lesson\*.cmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
