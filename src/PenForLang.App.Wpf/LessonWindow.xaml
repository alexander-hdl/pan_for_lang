<Window x:Class="PenForLang.App.Wpf.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenForLang"
        Width="1280"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Background="#FFFBF8EF"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False">
  <Window.Resources>
    <!-- Цели для пера: не меньше 12 мм (ARCHITECTURE.md §7.8, A34); точные размеры в мм выставляет код (ApplyTargetSizes). -->
    <Style x:Key="StripButton" TargetType="Button">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Padding" Value="26,12" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="LetterToggle" TargetType="ToggleButton">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <!-- Полоса и баннер лежат вне холста: касания здесь идут в WPF как нажатия кнопок, а не источнику пера. -->
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="StripHost"
            Grid.Row="0"
            Background="#FFE3DCC2"
            Padding="16,10">
      <DockPanel LastChildFill="False">
        <Button x:Name="LanguageButton"
                DockPanel.Dock="Right"
                Style="{StaticResource StripButton}"
                Margin="12,0,0,0"
                Click="OnLanguageClick" />
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Left"
                    Margin="0,0,16,0">
          <ToggleButton x:Name="LetterA"
                        Style="{StaticResource LetterToggle}"
                        Content="a"
                        Tag="a"
                        Click="OnLetterClick" />
          <ToggleButton x:Name="LetterI"
                        Style="{StaticResource LetterToggle}"
                        Content="i"
                        Tag="i"
                        Click="OnLetterClick" />
          <ToggleButton x:Name="LetterT"
                        Style="{StaticResource LetterToggle}"
                        Content="t"
                        Tag="t"
                        Click="OnLetterClick" />
        </StackPanel>
        <Button x:Name="ShowButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripButton}"
                Click="OnShowClick" />
        <Button x:Name="RestartButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripButton}"
                Click="OnRestartClick" />
        <Button x:Name="DoneButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripButton}"
                Click="OnDoneClick" />
        <Button x:Name="NextButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripButton}"
                FontWeight="SemiBold"
                Click="OnNextClick" />
        <Button x:Name="RestartLessonButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripButton}"
                Click="OnRestartLessonClick" />
        <TextBlock x:Name="RecordingBanner"
                   DockPanel.Dock="Left"
                   Margin="4,0,16,0"
                   Padding="12,6"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Background="#FFB3261E"
                   Visibility="Collapsed" />
        <TextBlock x:Name="ProgressText"
                   DockPanel.Dock="Left"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Foreground="#FF4A4A4A" />
      </DockPanel>
    </Border>

    <Border x:Name="BannerHost"
            Grid.Row="1"
            Padding="24,8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="InstructionText"
                   FontSize="20"
                   Foreground="#FF5A5A5A"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText"
                   Margin="0,4,0,0"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#FF3B3B3B"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid x:Name="CanvasHost"
          Grid.Row="2"
          ClipToBounds="True" />
  </Grid>
</Window>
