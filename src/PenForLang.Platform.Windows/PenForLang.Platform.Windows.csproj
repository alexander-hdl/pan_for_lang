<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WPF-интероп (HwndSource.AddHook), ARCHITECTURE.md §2.2 строка 12; XAML в сборке нет. -->
    <UseWPF>true</UseWPF>
    <!-- Нужно генератору LibraryImport (SYSLIB1062) и указателю на функцию EnumDisplayMonitors; небезопасного кода кроме fixed-буферов нет. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>P/Invoke и WPF-интероп: источники пера, мониторы, DPI. P/Invoke разрешён только здесь (R4).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PenForLang.Core\PenForLang.Core.csproj" />
    <ProjectReference Include="..\PenForLang.Ink\PenForLang.Ink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Чистые части (конвертация, владение, выбор монитора) тестируются на фейковых структурах. -->
    <InternalsVisibleTo Include="PenForLang.Platform.Windows.Tests" />
  </ItemGroup>

</Project>
