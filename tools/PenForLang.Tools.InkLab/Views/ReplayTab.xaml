<UserControl x:Class="PenForLang.Tools.InkLab.Views.ReplayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PenForLang.Tools.InkLab.Views">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="10">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="Папка…" Click="OnOpenFolder" Padding="14,6" Margin="0,0,8,0" />
        <Button Content="Файл…" Click="OnOpenFile" Padding="14,6" Margin="0,0,8,0" />
        <Button Content="Обновить" Click="OnRefresh" Padding="14,6" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Folder}" FontSize="11" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}" FontSize="13">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="#FF555555">
                <Run Text="{Binding Subject, Mode=OneWay}" /> · <Run Text="{Binding Group, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Grid Grid.Column="1" Margin="0,10,10,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <WrapPanel Grid.Row="0" Margin="0,0,0,8">
        <Button Content="Играть" Command="{Binding PlayCommand}" Padding="18,8" Margin="0,0,8,0" FontSize="16" />
        <Button Content="Пауза" Command="{Binding PauseCommand}" Padding="18,8" Margin="0,0,8,0" FontSize="16" />
        <Button Content="С начала" Command="{Binding RestartCommand}" Padding="18,8" Margin="0,0,8,0" FontSize="16" />
        <Button Content="Показать всё" Command="{Binding ShowAllCommand}" Padding="18,8" Margin="0,0,16,0" FontSize="16" />
        <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="SpeedBox" Width="80" VerticalAlignment="Center" SelectionChanged="OnSpeedChanged" />
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Width="180" Height="14" Margin="16,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" />
      </WrapPanel>

      <Border Grid.Row="1" BorderBrush="#FFB0A58A" BorderThickness="1">
        <views:StrokeView Scene="{Binding Scene}" />
      </Border>

      <StackPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Text="{Binding Status}" Foreground="#FF9A3412" Margin="0,0,0,4" />
        <TextBox Text="{Binding MetadataText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
