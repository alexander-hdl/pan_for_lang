<UserControl x:Class="PenForLang.Tools.InkLab.Views.AnnotateTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PenForLang.Tools.InkLab.Views">
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NextUnannotatedCommand}" />
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ToggleToolCommand}" />
    <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextCommand}" />
    <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PreviousCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <!-- Список записей -->
    <DockPanel Grid.Column="0" Margin="10">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="Папка…" Click="OnOpenFolder" Style="{StaticResource ToolButton}" />
        <Button Content="Обновить" Click="OnRefresh" Style="{StaticResource ToolButton}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Folder}" FontSize="11" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" FontSize="13">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="#FF555555">
                <Run Text="{Binding Group, Mode=OneWay}" /> · <Run Text="{Binding StateText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Центр: что написано и след -->
    <Grid Grid.Column="1" Margin="0,10,0,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Что написано:" VerticalAlignment="Center" FontSize="16" Margin="0,0,6,0" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="22" FontWeight="Bold" />
        <CheckBox Content="годится" IsChecked="{Binding IsUsable}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14" />
        <TextBlock Text="Разметчик:" VerticalAlignment="Center" Margin="14,0,6,0" />
        <TextBox Text="{Binding Annotator, UpdateSourceTrigger=LostFocus}" Width="90" VerticalAlignment="Center" ToolTip="Идентификатор разметчика сеанса: от него зависит имя файла разметки" />
      </StackPanel>

      <WrapPanel Grid.Row="1" Margin="0,0,0,6">
        <RadioButton x:Name="BoundaryTool" Content="Границы букв" GroupName="Tool" IsChecked="True" Checked="OnToolChecked" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14" />
        <RadioButton x:Name="DeferredTool" Content="Отложенные штрихи" GroupName="Tool" Checked="OnToolChecked" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14" />
        <TextBlock Text="Буква для отложенного:" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox x:Name="LetterBox" Width="56" VerticalAlignment="Center" SelectionChanged="OnLetterChanged" Margin="0,0,14,0" />
        <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" FontWeight="SemiBold" />
        <Button Content="◀" Command="{Binding PreviousCommand}" Style="{StaticResource ToolButton}" ToolTip="Предыдущая запись" />
        <Button Content="▶" Command="{Binding NextCommand}" Style="{StaticResource ToolButton}" ToolTip="Следующая запись" />
        <Button Content="К неразмеченной" Command="{Binding NextUnannotatedCommand}" Style="{StaticResource ToolButton}" />
      </WrapPanel>

      <Border Grid.Row="2" BorderBrush="#FFB0A58A" BorderThickness="1">
        <views:StrokeView x:Name="Strokes" Scene="{Binding Scene}" />
      </Border>

      <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#FF9A3412" Margin="0,6,0,0" TextWrapping="Wrap" />
    </Grid>

    <!-- Справа: стыки, отложенные, качество, замечания -->
    <ScrollViewer Grid.Column="2" Margin="10" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. Отложенные штрихи" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Сначала отметьте точку i и перекладину t (инструмент «Отложенные штрихи», Ctrl+D): кликните по штриху; повторный клик снимает отметку. Отложенные штрихи не входят в основной след." FontSize="11" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Deferred}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" Width="230" TextWrapping="Wrap" FontSize="12" />
                <Button Content="⇄" ToolTip="моё мнение о времени (по умолчанию время выводится из порядка штрихов)" Padding="6,2" Margin="4,0"
                        Command="{Binding DataContext.ToggleTimingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="✕" ToolTip="снять отметку" Padding="6,2"
                        Command="{Binding DataContext.RemoveDeferredCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="2. Стыки между буквами" FontWeight="SemiBold" Margin="0,10,0,4" />
        <TextBlock Text="Для стыка два клика: выход левой буквы (где кончается её тело) и вход правой (где начинается; у t — верх подъёма). Между ними — соединительный штрих. Shift+клик — граница одной точкой. Стрелки ←/→ сдвигают последнюю точку на одну точку записи." FontSize="11" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Junctions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" Padding="6" Margin="0,0,0,4">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#FFCCCCCC" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF1D4ED8" />
                        <Setter Property="Background" Value="#FFEFF4FF" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Label}" FontSize="18" FontWeight="Bold" MinWidth="56" Padding="8,2"
                            Command="{Binding DataContext.SelectJunctionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding KindText}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{Binding PointText}" FontSize="12" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding PhaseText}" FontSize="11" Foreground="#FF1D4ED8" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="{Binding ConfidenceText}" Padding="8,2" Margin="0,0,6,0" FontSize="11"
                            Command="{Binding DataContext.CycleConfidenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="сбросить" Padding="8,2" FontSize="11"
                            Command="{Binding DataContext.ClearJunctionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="3. Качество" FontWeight="SemiBold" Margin="0,10,0,4" />
        <ItemsControl ItemsSource="{Binding Flags}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,0,0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Заметка" Margin="0,6,0,2" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="50" />

        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold">
          <Run Text="Проверка: " />
          <Run>
            <Run.Style>
              <Style TargetType="Run">
                <Setter Property="Text" Value="есть ошибки" />
                <Setter Property="Foreground" Value="#FFB91C1C" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsValid}" Value="True">
                    <Setter Property="Text" Value="в порядке" />
                    <Setter Property="Foreground" Value="#FF15803D" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Run.Style>
          </Run>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Другие разметчики (только чтение)" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ItemsControl ItemsSource="{Binding OtherAnnotations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="12" Margin="0,0,0,2">
                <Run Text="{Binding Annotator, Mode=OneWay}" FontWeight="SemiBold" /> — <Run Text="{Binding State, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
