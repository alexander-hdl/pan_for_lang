root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.sln]
end_of_line = crlf
indent_style = tab

[*.{csproj,props,targets,xaml,json,yml,yaml,config,manifest,resx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Стиль C# (ARCHITECTURE.md §2.1)
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Константы и static-поля — PascalCase (правило конкретнее, чем «приватные поля»).
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.static_fields_pascal.severity = warning
dotnet_naming_rule.static_fields_pascal.symbols = static_fields
dotnet_naming_rule.static_fields_pascal.style = pascal_case
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Тесты: имена методов вида Method_Scenario_Result допустимы.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# F12: в доменных проектах зависимость от текущей культуры — ошибка (CA1304 — CultureInfo, CA1305 — IFormatProvider,
# CA1310 — StringComparison). WPF-проекты работают без инвариантной глобализации (Directory.Build.targets),
# поэтому домен обязан указывать культуру и сравнение явно. Наличие правил проверяет Architecture.Tests.
[src/PenForLang.{Core,Ink,Glyphs,Evaluation,Evaluation.Abstractions,Curriculum,Learner,Lesson,Reporting}/**.cs]
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1310.severity = error
