<Project>

  <!-- Central Package Management: версии пакетов задаются только здесь. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <!-- MIT. Запрещённые API в домене (ARCHITECTURE.md §2.4, R2). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- MIT. Командная строка `pfl`. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xUnit v3 (Apache-2.0), ARCHITECTURE.md §10.1. Запуск через Microsoft.Testing.Platform (global.json -> test.runner). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- MIT (github.com/BenMorris/NetArchTest, проверено в V0.1). Архитектурные тесты R1, R3, R4. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
