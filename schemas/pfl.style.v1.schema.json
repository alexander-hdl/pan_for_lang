{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pfl:schema:style:1",
  "title": "pfl.style/1",
  "description": "Style package description, style.json (ARCHITECTURE.md 3.2.2). Rules that a schema cannot express (xHeight = 1 and baseline = 0, unique join rules, trademark-free display names, directory name = id) are checked by PenForLang.Glyphs.Loading.StyleManifestParser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "version", "role", "script", "language", "displayName", "lines", "slantDeg", "slantScoring", "letterSpacing", "wordSpacing",
    "joins", "variantRules", "motorFamilies", "capitals", "deferred", "animation"
  ],
  "properties": {
    "schema": { "const": "pfl.style/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "description": "Internal style id; never shown in the UI." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "role": { "enum": ["teach", "print", "confuser"] },
    "script": { "enum": ["cursive", "print"] },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "displayName": {
      "type": "object",
      "required": ["ru", "en"],
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "UI name per language. Must not contain a trademark (Zaner, Bloser)."
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ascender", "cap", "xHeight", "baseline", "descender"],
      "properties": {
        "ascender": { "type": "number", "minimum": -3, "maximum": 4 },
        "cap": { "type": "number", "minimum": -3, "maximum": 4 },
        "xHeight": { "const": 1 },
        "baseline": { "const": 0 },
        "descender": { "type": "number", "minimum": -3, "maximum": 0 }
      }
    },
    "slantDeg": { "type": ["number", "null"], "minimum": -45, "maximum": 45, "description": "Degrees from vertical, positive = to the right. Used for geometry and ruler guides even while slantScoring is 'consistency'." },
    "slantScoring": { "enum": ["consistency", "absolute"], "description": "'consistency': the evaluator checks only that the slant is constant (the absolute slant is not verified against the copybook); 'absolute' needs a numeric slantDeg and is allowed only once the style is reviewed." },
    "letterSpacing": { "type": "number", "minimum": 0, "maximum": 2 },
    "wordSpacing": { "type": "number", "minimum": 0, "maximum": 5 },
    "joins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "tallEntryClass"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "exit", "entry", "shape"],
            "properties": {
              "family": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^JF[1-9]$" }] },
              "exit": { "enum": ["X-BASE", "X-HIGH", "X-DESC", "X-NONE"] },
              "entry": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": { "enum": ["E-UP", "E-UP-TALL", "E-C", "E-HUMP", "*"] }
              },
              "shape": { "enum": ["hermite", "hermite-over", "break"] },
              "high": { "type": "boolean" },
              "params": { "type": "object", "additionalProperties": { "type": "number", "minimum": -10, "maximum": 10 } }
            }
          }
        },
        "tallEntryClass": { "enum": ["E-UP", "E-UP-TALL", "E-C", "E-HUMP"] },
        "pairOverrides": { "type": "array", "maxItems": 0, "description": "Reserved: not supported by the v0 loader, must be empty." }
      }
    },
    "variantRules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["char", "when", "variant"],
        "properties": {
          "char": { "type": "string", "minLength": 1, "maxLength": 1 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prevExit"],
            "properties": { "prevExit": { "enum": ["X-BASE", "X-HIGH", "X-DESC", "X-NONE"] } }
          },
          "variant": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        }
      }
    },
    "motorFamilies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": { "type": "string", "minLength": 1, "maxLength": 1 }
      }
    },
    "capitals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joinMode"],
      "properties": { "joinMode": { "enum": ["break", "join"] } }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teachTiming"],
      "properties": { "teachTiming": { "enum": ["afterWord", "afterLetter"] } }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speedXhPerSec", "cuspPauseMs", "joinSlowdown", "strokeGapMs", "deferredGapMs", "startHoldMs", "endHoldMs", "dotMs"],
      "properties": {
        "speedXhPerSec": { "type": "number", "minimum": 0.05, "maximum": 10 },
        "cuspPauseMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "joinSlowdown": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "strokeGapMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "deferredGapMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "startHoldMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "endHoldMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "dotMs": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    }
  }
}
