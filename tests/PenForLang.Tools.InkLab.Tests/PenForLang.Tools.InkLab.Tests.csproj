<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\PenForLang.Tools.InkLab\PenForLang.Tools.InkLab.csproj" />
    <!-- FakeMonotonicClock, FakeClock, FakePenInputSource. -->
    <ProjectReference Include="..\..\tools\PenForLang.Testing\PenForLang.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- В WPF-проектах System.IO не входит в неявные using; нужен и тестам, и связанным файлам Glyphs.Tests. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Проверка файлов разметки по JSON Schema: тот же минимальный проверяющий, что у тестов глифов. -->
    <Compile Include="..\PenForLang.Glyphs.Tests\Support\MiniJsonSchema.cs" Link="Support\MiniJsonSchema.cs" />
    <Compile Include="..\PenForLang.Glyphs.Tests\Support\Repo.cs" Link="Support\Repo.cs" />
  </ItemGroup>

</Project>
